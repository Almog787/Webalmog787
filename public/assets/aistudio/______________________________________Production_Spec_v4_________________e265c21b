            python stt/scripts/merge_and_diarize.py \
              --chunks-dir stt/merged_inputs/chunks \
              --slug "$SLUG" \
              --diarize \
              --diarization-model "$DIARIZATION_MODEL" \
              --clean-wav "stt/merged_inputs/full_audio/clean_audio.wav" \
              --out-dir stt/transcripts
          else
            python stt/scripts/merge_and_diarize.py \
              --chunks-dir stt/merged_inputs/chunks \
              --slug "$SLUG" \
              --out-dir stt/transcripts
          fi


      - name: Optional AES-256 encryption for public-repo privacy
        id: pack
        env:
          TRANSCRIPT_PASSPHRASE: ${{ secrets.TRANSCRIPT_PASSPHRASE }}
          ENCRYPT_OUTPUT: ${{ inputs.encrypt_output }}
        run: |
          if [ "$ENCRYPT_OUTPUT" = "true" ]; then
            if [ -z "$TRANSCRIPT_PASSPHRASE" ]; then
              echo "::error::encrypt_output=true requires TRANSCRIPT_PASSPHRASE secret."
              exit 1
            fi
            tar -czf stt/transcripts.tar.gz -C stt/transcripts .
            printf '%s' "$TRANSCRIPT_PASSPHRASE" | gpg --batch --yes --passphrase-fd 0 --symmetric --cipher-algo AES256 -o stt/transcripts-encrypted.tar.gz.gpg stt/transcripts.tar.gz
            rm -rf stt/transcripts stt/transcripts.tar.gz
            echo "artifact_path=stt/transcripts-encrypted.tar.gz.gpg" >> "$GITHUB_OUTPUT"
          else
            echo "artifact_path=stt/transcripts/" >> "$GITHUB_OUTPUT"
          fi


      - name: Upload final transcripts artifact
        uses: actions/upload-artifact@v7
        with:
          name: transcripts-${{ needs.prepare.outputs.slug }}-run-${{ github.run_number }}-${{ github.run_attempt }}
          path: ${{ steps.pack.outputs.artifact_path }}
          if-no-files-found: error
          retention-days: 3


