# Target website URL (required, must be http:// or https://)
TARGET_URL="https://example.com"

# Maximum pages to crawl (1..200, default: 25)
MAX_PAGES="25"

# Maximum link crawl depth (0..5, default: 2)
MAX_DEPTH="2"

# Viewports to capture: desktop+mobile | desktop-only
VIEWPORTS="desktop+mobile"

# Browser stealth mode: chrome-xvfb | chromium-headless
STEALTH_MODE="chrome-xvfb"

# Unpack JS bundles via SourceMaps, Webcrack, and Wakaru: true | false
UNPACK_JS="true"

# Tree-sitter compress unpacked JS in Repomix: true | false
COMPRESS_OUTPUT="true"

# Run Katana Go crawler for early endpoint discovery: true | false
ENABLE_KATANA="true"

# Prune unused CSS rules via PurgeCSS before packing: true | false
ENABLE_PURGECSS="true"

# Save offline self-contained HTML snapshot via SingleFile CLI: true | false
ENABLE_SINGLEFILE="true"

# Optional path for SingleFile offline HTML snapshot
SNAPSHOT_OUT_PATH="extractions/snapshots/latest.html"

# Soft token budget warning threshold (default: 180000)
TOKEN_BUDGET="180000"

# Optional HTTP/SOCKS proxy URL (typically injected from GitHub Secrets)
PROXY_URL=""

# Output directory for extracted artifacts (default: ./extracted)
EXTRACTED_DIR="./extracted"

# Isolated Crawlee storage directory (default: ./storage)
CRAWLEE_STORAGE_DIR="./storage"

# Override Crawlee memory budget in MB on 7-8 GB CI runners
CRAWLEE_MEMORY_MBYTES="5120"
